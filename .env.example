# ─── Elasticsearch ─────────────────────────────────────────
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASS=
ES_INDEX=knowledge_base

# ─── Embeddings (OpenAI 兼容 /v1/embeddings) ────────────────
# 默认 SiliconFlow；亦可填 Jina / OpenAI / DashScope 等
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBED_DIMS=1024

# ─── Tavily Web Search ──────────────────────────────────────
TAVILY_API_KEY=

# ─── LLM 路由 (OpenAI 兼容 /v1/chat/completions) ─────────────
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_MODEL_FAST=deepseek-v4-flash
